ated","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":2,"dt_root_h":0.211,"parent_id":"1876657211499573570","conversation_id":"1876657211499573570"},{"id":"1876662727479050718","x":0.018585,"y":7.0,"t":1736266235,"iso":"2025-01-07T16:10:35.000Z","rt":0,"replies":0,"quotes":0,"likes":2,"relation":"reply","niveau":2,"author":"ann_mcnitt","author_id":"1476669759374639107","text":"@Syrupie @DrSdeG The \"100-day cough\" is pertussis/whooping cough. It's deadly dangerous for infants.","in_corpus":false,"depth":2,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.365,"parent_id":"1876660394548490452","conversation_id":"1876657211499573570"},{"id":"1876659427996283096","x":0.007462,"y":4.5,"t":1736265448,"iso":"2025-01-07T15:57:28.000Z","rt":0,"replies":4,"quotes":0,"likes":27,"relation":"reply","niveau":1,"author":"sean9n","author_id":"64986227","text":"@DrSdeG we do on our extended swabs. only seen a couple. more rhino. loads of flu","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":6,"dt_root_h":0.147,"parent_id":"1876657211499573570","conversation_id":"1876657211499573570"},{"id":"1876768310450110652","x":0.374357,"y":6.0,"t":1736291408,"iso":"2025-01-07T23:10:08.000Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":2,"author":"strawfie","author_id":"3345612251","text":"@sean9n @DrSdeG Sharing this petition calling for the introduction of new air quality and PPE rules for health and social care settings\n\nhttps://t.co/tTyuSo646G","in_corpus":false,"depth":2,"subtree_rt":0,"subtree_size":1,"dt_root_h":7.358,"parent_id":"1876659427996283096","conversation_id":"1876657211499573570"},{"id":"1876669029274067149","x":0.039827,"y":5.0,"t":1736267738,"iso":"2025-01-07T16:35:38.000Z","rt":0,"replies":0,"quotes":0,"likes":2,"relation":"reply","niveau":2,"author":"Oldboatie","author_id":"303350890","text":"@sean9n @DrSdeG Thanks. Mostly I hear of nobody being tested for any virus so this is reassuring on both counts.","in_corpus":false,"depth":2,"