3931504","x":0.184356,"y":12.0,"t":1736223903,"iso":"2025-01-07T04:25:03.000Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":1,"author":"mdakilazhar7888","author_id":"2257908858","text":"@DipakAgrahari3 Bahut hi Achcha Jankari Diya aapane HMPV ke bare mein","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.343,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484825882017915","x":0.171966,"y":11.0,"t":1736223820,"iso":"2025-01-07T04:23:40.000Z","rt":0,"replies":0,"quotes":0,"likes":1,"relation":"reply","niveau":1,"author":"Seemajakhar0008","author_id":"1490128460895105028","text":"@DipakAgrahari3 You have given very good information about this virus.","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.32,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484594880619002","x":0.163756,"y":10.0,"t":1736223765,"iso":"2025-01-07T04:22:45.000Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":1,"author":"Ravindradhaka0","author_id":"1811947099510177792","text":"@DipakAgrahari3 Your information is always right","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.305,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484571208032570","x":0.16286,"y":9.0,"t":1736223759,"iso":"2025-01-07T04:22:39Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":1,"author":"imjagdish78","author_id":"1710228168257458176","text":"@DipakAgrahari3 Human Metapneumovirus (HMPV) is a respiratory virus that causes flu-like symptoms and can lead to severe illness in vulnerable individuals.","in_corpus":true,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.303,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484539901415459","x":0.161815,"y":8.0,"t":1736223752,"iso":"2025-01-07T04:22:32.000Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":1,"author":"rajyadav11321","author_id":"840819032412606464","text":"Symptoms typically include a cough, fever, sore throat, and nasal congestion, with some cases also experiencing wheezing or shortness of breath. While the virus usually results in mild illness, certain individuals - especially the very young, elderly, or those with weakened immune systems - may develop more severe respiratory conditions, such as pneumonia or bronchiolitis.","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.301,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484536911217142","x":0.161666,"y":7.0,"t":1736223751,"iso":"2025-01-07T04:22:31Z","rt":0,"replies":0,"quotes":0,"likes":2,"relation":"reply","niveau":1,"author":"BRCHOUDHARY8976","author_id":"1838127201625206784","text":"@DipakAgrahari3 Human Metapneumovirus (HMPV) is a contagious respiratory virus that causes mild to moderate flu-like symptoms. It mainly spreads through:\n1. Direct contact with infected individuals\n2. Contaminated surfaces\nHMPV typically circulates during winter and early spring months.","in_corpus":true,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.301,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484533538963555","x":0.161517,"y":6.0,"t":1736223750,"iso":"2025-01-07T04:22:30.000Z","rt":0,"replies":0,"quotes":0,"likes":1,"relation":"reply","niveau":1,"author":"Vijaysiyag_bmr","author_id":"1828630416850591747","text":"@DipakAgrahari3 Thanks for information shared","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.301,"parent_id":"1876479992915431703","conversation_id":"1876479992915431703"},{"id":"1876484162728718761","x":0.14838,"y":5.0,"t":1736223662,"iso":"2025-01-07T04:21:02.000Z","rt":0,"replies":0,"quotes":0,"likes":0,"relation":"reply","niveau":1,"author":"jandu_pukhraj","author_id":"873569822411337728","text":"@DipakAgrahari3 जानकारी द