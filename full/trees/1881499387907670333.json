y":5.0,"t":1737421058,"iso":"2025-01-21T00:57:38.000Z","rt":0,"replies":0,"quotes":0,"likes":1,"relation":"reply","niveau":2,"author":"jakki_jax","author_id":"1053442264528121856","text":"@ComRedSoda You know it!!","in_corpus":false,"depth":2,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.465,"parent_id":"1881505119172460708","conversation_id":"1881499387907670333"},{"id":"1881504696076275744","x":0.007955,"y":4.0,"t":1737420650,"iso":"2025-01-21T00:50:50.000Z","rt":0,"replies":1,"quotes":1,"likes":2,"relation":"reply","niveau":1,"author":"Silent_LLC","author_id":"4659079822","text":"@jakki_jax lots of rest, supplements and water...get better soon","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":5,"dt_root_h":0.351,"parent_id":"1881499387907670333","conversation_id":"1881499387907670333"},{"id":"1881506636805951727","x":0.010867,"y":4.0,"t":1737421113,"iso":"2025-01-21T00:58:33.000Z","rt":0,"replies":1,"quotes":0,"likes":0,"relation":"reply","niveau":2,"author":"jakki_jax","author_id":"1053442264528121856","text":"@Silent_LLC I'm looking into some new supplements and going back to eating yogurt for probiotics. Not sure why I ever stopped eating yogurt, guess I'm an idiot. 😵‍💫","in_corpus":false,"depth":2,"subtree_rt":0,"subtree_size":4,"dt_root_h":0.48,"parent_id":"1881504696076275744","conversation_id":"1881499387907670333"},{"id":"1881507586975133966","x":0.012295,"y":4.0,"t":1737421340,"iso":"2025-01-21T01:02:20.000Z","rt":0,"replies":1,"quotes":0,"likes":0,"relation":"reply","niveau":3,"author":"Silent_LLC","author_id":"4659079822","text":"@jakki_jax My wife just finished her antibiotics for her BSL-4 virus and is now reconstructing her gut biome with yogurt, sauerkraut and other pre &amp; probiotics. Let food be thy medicine :)","in_corpus":false,"depth":3,"subtree_rt":0,"subtree_size":3,"dt_root_h":0.543,"parent_id":"1881506636805951727","conversation_id":"1881499387907670333"},{"id":"1881508012764140008","x":0.01293,"y":4.0,"t":1737421441,"iso":"2025-01-21T01:04:01.000Z","rt":0,"replies":2,"quotes":0,"likes":1,"relation":"reply","niveau":4,"author":"jakki_jax","author_id":"1053442264528121856","text":"@Silent_LLC Yeah they gave me a few massive doses of strong IV antibiotics at first before they realized what I had. So I really need to rebuild. I'll look for sauerkraut but that can be hard to find. I've got a few ideas of places to look though.","in_corpus":false,"depth":4,"subtree_rt":0,"subtree_size":2,"dt_root_h":0.571,"parent_id":"1881507586975133966","conversation_id":"1881499387907670333"},{"id":"1881508708246814914","x":0.013974,"y":4.0,"t":1737421607,"iso":"2025-01-21T01:06:47.000Z","rt":0,"replies":0,"quotes":0,"likes":1,"relation":"reply","niveau":5,"author":"Silent_LLC","author_id":"4659079822","text":"@jakki_jax anything fermented, but not sure what in Mexican cuisine would be fermented ...?","in_corpus":false,"depth":5,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.617,"parent_id":"1881508012764140008","conversation_id":"1881499387907670333"},{"id":"1881503376845971749","x":0.005981,"y":3.0,"t":1737420336,"iso":"2025-01-21T00:45:36.000Z","rt":0,"replies":0,"quotes":0,"likes":1,"relation":"reply","niveau":1,"author":"ross_couzens","author_id":"1453001977424711690","text":"@jakki_jax Glad to hear you're on the mend, don't over do it though take what time you need to rest.","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.264,"parent_id":"1881499387907670333","conversation_id":"1881499387907670333"},{"id":"1881503331081949369","x":0.005911,"y":2.0,"t":1737420325,"iso":"2025-01-21T00:45:25.000Z","rt":0,"replies":1,"quotes":0,"likes":1,"relation":"reply","niveau":1,"author":"motleyjoo","author_id":"1634212564706947072","text":"@jakki_jax We'll recover together, apart, on twitter","in_corpus":false,"depth":1,"subtree_rt":0,"subtree_size":3,"dt_root_h":0.261,"parent_id":"1881499387907670333","conversation_id":"1881499387907670333"},{"id":"1881507316459303240","x":0.011886,"y":2.0,"