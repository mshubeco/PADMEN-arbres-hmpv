76257780878975382","conversation_id":"1876257780878975382"},{"id":"1876259353894006895","x":0.002592,"y":1.0,"t":1736170063,"iso":"2025-01-06T13:27:43.000Z","rt":0,"replies":0,"quotes":0,"likes":2,"relation":"reply","niveau":2,"author":"hemantrajora_","author_id":"168976061","text":"@drmohansai Thank you mohan sai","in_corpus":false,"depth":2,"subtree_rt":0,"subtree_size":1,"dt_root_h":0.104,"parent_id":"1876258866201346212","conversation_id":"1876257780878975382"},{"id":"1876257785199133003","x":7e-06,"y":0.0,"t":1736169689,"iso":"2025-01-06T13:21:29Z","rt":15,"replies":1,"quotes":0,"likes":41,"relation":"reply","niveau":1,"author":"hemantrajora_","author_id":"168976061","text":"By the age of 5 years, &gt;90% of individuals have evidence of HMPV infection. \n\nNearly 100 % adults have HMPV specific antibody \n\nPresence of HMPV antibodies in samples obtained in \n1958 showed that the virus is 50 years old  (van den \nHoogen et al 2001,Netherlands)\n#HMVP 2/3","in_corpus":true,"depth":1,"subtree_rt":31,"subtree_size":4,"dt_root_h":0.0,"parent_id":"1876257780878975382","conversation_id":"1876257780878975382"},{"id":"1876257789414400290","x":1.4e-05,"y":0.0,"t":1736169690,"iso":"2025-01-06T13:21:30Z","rt":15,"replies":1,"quotes":0,"likes":38,"relation":"reply","niveau":2,"author":"hemantrajora_","author_id":"168976061","text":"Most HMPV infections occur in &lt; 5 years of age, with \nchildren &lt;2 years of age being most at risk for serious HMPV \ninfections. In one study the peak was seen at 4–6 months \nof age\n\nThe activity of #HMPV in temperate climates peaks \nbetween December and February\n3/3","in_corpus":true,"depth":2,"subtree_rt":16,"subtree_size":3,"dt_root_h":0.001,"parent_id":"1876257785199133003","conversation_id":"1876257780878975382"},{"id":"1876262645034344551","x":0.008017,"y":0.0,"t":1736170848,"iso":"2025-01-06T13:40:48.000Z","rt":0,"replies":1,"quotes":0,"likes":0,"relation":"reply","niveau":3,"author":"gaathiwrites","author_id":"78257120","text